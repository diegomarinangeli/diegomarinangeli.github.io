# Copy to .env and fill in. Used by scripts/generate-project.mjs.

# Optional — drafts card copy, page content, and cover art via the Anthropic
# API. If left empty, the script falls back to your locally logged-in
# `claude` CLI session instead (no key needed).
ANTHROPIC_API_KEY=

# Optional — raises the GitHub API rate limit and is required for repos
# in orgs you collaborate in (not under your own account).
GITHUB_TOKEN=

# Optional — defaults to the owner in `git remote get-url origin`.
GITHUB_USER=
